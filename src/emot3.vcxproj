    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Plus|x64">
      <Configuration>Plus</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Dev|x64">
      <Configuration>Dev</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Distribution|x64">
      <Configuration>Distribution</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="DistributionDevTools|x64">
      <Configuration>DistributionDevTools</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
