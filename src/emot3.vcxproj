  <!--
    Output layout, shared by all configs via the $(Configuration) macro:
    build\<Config>\<dll>, intermediates in build\<Config>\obj\. (x64-only, so
    the platform isn't in the path.) Per-config folders give each config its own
    incremental-build database, so switching configs doesn't force a full rebuild.
  -->
  <PropertyGroup>
    <OutDir>$(SolutionDir)build\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\$(Configuration)\obj\</IntDir>
  </PropertyGroup>
