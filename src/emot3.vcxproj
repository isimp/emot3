    <OutDir>$(SolutionDir)build\$(Configuration)\$(Platform)\</OutDir>
    <IntDir>$(SolutionDir)build\$(Configuration)\$(Platform)\obj\</IntDir>
  </PropertyGroup>
  <!--
    Per-config DLL name. Debug + Distribution both produce emot3.dll (in their
    own folders); Plus and Dev get distinct names so the three shipping-ish
    DLLs never collide and CI can attach them by name.
