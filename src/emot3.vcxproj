  <!--
    Bundled artwork. emot3.rc and ResourcesGenerated.cpp are produced by
    tools/gen_rc.py (see the GenerateResources target below) from the PNGs
    in resources/. They live in src/generated/ so they're clearly tagged
    as auto-generated and sit out of the way of hand-written modules.
    Paths inside the .rc are computed relative to the .rc's directory by
    the generator, so rc.exe resolves them whether it runs from src/ or
    from src/generated/.
  -->
  <ItemGroup>
    <ResourceCompile Include="generated\emot3.rc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!--
    Pre-build codegen. Runs before both ClCompile and ResourceCompile so
    Resources.cpp's references to the manifest tables resolve, and so
    rc.exe sees a fresh emot3.rc. Requires the 'py' Windows Python
    launcher (ships with the standard python.org installer).

    Uses Inputs/Outputs so MSBuild only runs the script when a PNG or the
    script itself changes - incremental builds stay fast.
  -->
  <Target Name="GenerateResources"
          BeforeTargets="ClCompile;ResourceCompile"
          Inputs="$(ProjectDir)..\tools\gen_rc.py;$(ProjectDir)..\resources\emotes_official\*.png;$(ProjectDir)..\resources\emotes_ai\*.png;$(ProjectDir)..\resources\ui\*.png;$(ProjectDir)..\resources\i18n\*.json;$(ProjectDir)..\resources\emote_data\*.json"
          Outputs="$(ProjectDir)generated\emot3.rc;$(ProjectDir)generated\ResourcesGenerated.cpp">
    <Message Text="Generating generated\emot3.rc and generated\ResourcesGenerated.cpp from resources/" Importance="High" />
    <Exec Command="py -3 &quot;$(ProjectDir)..\tools\gen_rc.py&quot;" />
  </Target>
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
