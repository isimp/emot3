    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Plus|x64">
      <Configuration>Plus</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="PlusDevTools|x64">
      <Configuration>PlusDevTools</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Distribution|x64">
      <Configuration>Distribution</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="DevTools|x64">
      <Configuration>DevTools</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
